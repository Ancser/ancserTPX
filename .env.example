TOPSTEPX_USERNAME=
TOPSTEPX_API_KEY=

# Databento historical data (GLBX.MDP3). Only used by scripts/databento_backfill.py
# to backfill 1m bars older than the TopstepX ~60-day retention window.
# Key is usage-billed: keep it out of any script that runs unattended.
DATABENTO_API_KEY=

# EMAPMO Discord signal messenger. Both Web LIVE and Terminal LIVE read this
# same root .env. Keep disabled until one transport below is configured.
EMAPMO_MESSENGER_ENABLED=false

# Preferred: one official Discord webhook tied to exactly one channel.
EMAPMO_DISCORD_WEBHOOK_URL=

# Optional ancserMessenger-compatible transport. For a bot token use "bot".
# A personal/user token requires "user" and may violate Discord's terms.
DISCORD_TOKEN=
EMAPMO_DISCORD_CHANNEL_ID=
EMAPMO_DISCORD_AUTH_MODE=bot

# Bounded queue and disk-only history. No chart images are retained.
EMAPMO_SIGNAL_HISTORY_DAYS=30
EMAPMO_SIGNAL_CHART_BARS=96
EMAPMO_SIGNAL_QUEUE_SIZE=8
EMAPMO_SIGNAL_TIMEZONE=America/Chicago
