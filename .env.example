TOPSTEPX_USERNAME=
TOPSTEPX_API_KEY=

# Web control is loopback-only and API docs are disabled by default. Enable
# docs only for deliberate local development; this does not expose the server.
ANCSERTPX_DEV_DOCS=false

# Databento GLBX.MDP3 historical/live MBO access. Historical scripts use it to
# backfill 1m bars older than the TopstepX ~60-day retention window. The key is
# usage-billed; the native app uses it for live capture only when configured.
DATABENTO_API_KEY=

# The native desktop app sets this to true automatically so a record-only MBO
# stream continues while the app is open.  Set false for a server-only session.
ANCSERTPX_AUTO_DATABENTO_MBO=false

# EMAPMO Discord signal messenger. Both Web LIVE and Terminal LIVE read this
# same root .env. Keep disabled until one transport below is configured.
EMAPMO_MESSENGER_ENABLED=false

# Preferred: one official Discord webhook tied to exactly one channel.
EMAPMO_DISCORD_WEBHOOK_URL=

# Optional ancserMessenger-compatible transport. For a bot token use "bot".
# A personal/user token requires "user" and may violate Discord's terms.
DISCORD_TOKEN=
EMAPMO_DISCORD_CHANNEL_ID=
EMAPMO_DISCORD_AUTH_MODE=bot

# Bounded queue and disk-only history. No chart images are retained.
EMAPMO_SIGNAL_HISTORY_DAYS=30
EMAPMO_SIGNAL_CHART_BARS=96
EMAPMO_SIGNAL_QUEUE_SIZE=8
EMAPMO_SIGNAL_TIMEZONE=America/Chicago

# MarketData lives outside this repository. Defaults on Windows are the
# sibling ..\ancserMarketData and the E: mirror below. Override before launch
# when another machine uses different volumes. Separate multiple mirrors with
# ; on Windows or : on macOS/Linux.
# ANCSER_MARKET_DATA_ROOT=
# ANCSER_MARKET_DATA_BACKUP_ROOTS=E:\ancserMarketData
