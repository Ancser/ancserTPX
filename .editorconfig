# 1.0.8: 強制 UTF-8 與一致換行，避免中文字串再被存成 cp1252 導致亂碼
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = false

[*.{py,js,css,html}]
indent_style = space
end_of_line = lf

[*.{bat,ps1}]
end_of_line = crlf

[*.{sh,command}]
end_of_line = lf

[Makefile]
indent_style = tab
