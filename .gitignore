# PyCharm
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Ruff stuff:
.ruff_cache/

# PyPI configuration file
.pypirc

# Cursor  
#  Cursor is an AI-powered code editor.`.cursorignore` specifies files/directories to 
#  exclude from AI features like autocomplete and code analysis. Recommended for sensitive data
#  refer to https://docs.cursor.com/context/ignore-files
.cursorignore
.cursorindexingignore

# ─── /data retention policy (1.0.9) ──────────────────────────────────────────
# Keep ONLY the accumulated candle store under /data; ignore everything else so
# backtest / sweep / ML / live-state / trades / ACCOUNT data are never uploaded.
# Strategy presets stay private on this machine and must never be tracked.
#   • data/store/         — accumulated 1m candle store (*.pkl + meta)
# NOTE on branch switching: git leaves *ignored* files alone on checkout, so the
# ignored data below is NOT lost when you switch branches — it just isn't tracked
# or uploaded. Keep private preset backups outside this repository.
data/*
!data/store/
# 1.0.9: preset 恢復追蹤 —— 它是策略定義(BEST/SECOND BEST 等),屬於原始碼
# 的一部分,不是帳號資料。憑證仍只存在 .env。
!data/presets.json

# Ad-hoc research scripts / exports (may contain account data) — never upload.
scratchpad/
*.local.py

# ── 1.0.10: 蠟燭資料庫不進版控 ────────────────────────────────────
# 完整 store 是 210MB/商品(2020 起,含 Databento 補齊段)。git 對二進位檔
# 是每個版本存一份完整 blob,而 accumulator 每小時重寫整個檔案 —— 追蹤它
# 會讓 repo 無上限膨脹,而且 >100MB 直接推不上 GitHub。
#
# 這份資料是**可重建的**:scripts/databento_backfill.py + accumulator。
# 完整備份在版控外的 F:/ancserQuant/ancserData/(見該處 MANIFEST.json)。
#
# 例外:data/store/seed/ 有進版控 —— 那是 6MB 的開機種子,只含自家 TopstepX
# 抓的 2026-06 之後資料,給全新環境跑 warm-up / 回測用。
data/store/*.pkl
data/store/*.pkl.bak
data/store/*.pkl.tmp
!data/store/seed/*.pkl
